	StackResolver.pass_priority(state, db)
	StackResolver.pass_priority(state, db)
	eq(state.get_card("victim").zone_id, "p2_graveyard", "gh-f: target destroyed")
	ok(state.pending_enter_play_effect.is_empty(), "gh-g: pending effect cleared")


