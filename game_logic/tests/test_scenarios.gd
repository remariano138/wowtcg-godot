func _test_herods_shoulder_decline_and_ai() -> void:
	_buf.append("\n-- Herod's Shoulder: decline still shuffles; AI always takes the weapon --")
	var db := _herod_db()
	var state := _base_state(db, "p1_hero", "p2_hero")
