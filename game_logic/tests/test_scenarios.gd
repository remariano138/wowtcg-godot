	_add_resources(st2, "p1", 4)
	_add_staff(st2, "staff", "p1")
	_add_ally(st2, "big", "titan_def", "p2").just_summoned = false
	_add_ally(st2, "mid", "brute_def", "p2").just_summoned = false
	_add_ally(st2, "small", "grunt_def", "p2").just_summoned = false
	var ai := BaseAI.new()
