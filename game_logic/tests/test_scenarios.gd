	var mine := _add_ally(st, "mine", "bear_def", "p1")
	mine.just_summoned = false
	var poison := _add_hand_card(st, "poison", "deadly_def", "p1")

	# (a) Nothing damaged yet -- no legal target, and the card goes DARK.
