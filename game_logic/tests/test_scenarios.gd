	# Announced target leaves play before resolution → 706 fizzle.
	var s3 := _base_state(db, "p1_hero", "p2_hero")
	_add_resources(s3, "p1", 4)
	_add_card_to_hand(s3, "karkas3", "karkas_def", "p1")
