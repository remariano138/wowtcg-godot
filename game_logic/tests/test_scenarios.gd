	state.pending_deck_search_type = "Weapon"
	var ai := BaseAI.new()
	var pick := ai.choose_deck_search_to_top(state, db, "p1", "Weapon")
	eq(pick, "sword_inst", "hs-l: AI always searches out the weapon")


