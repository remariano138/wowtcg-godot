	db.hero("p2_hero", 30)
	db.ally("filler_def", 1, 1, [], 1)
	db.instant("azeroth_128", 2, "draw:2|play_cost_put_damage_hero:2")
	db.instant("counter_def", 1, "interrupt_ability")
