	eq(mine.damage_taken, 1, "hs-e: fires on the OPPONENT's turn too")
	eq(state.get_card("p1_hero").damage_taken, 0, "hs-f: hero healed again")
	eq(theirs.damage_taken, 3, "hs-g: opposing party still untouched")

