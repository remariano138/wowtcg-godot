			{"card_id": "pr3"}), db),
		"ph-h: legal on an undamaged board (a wasteful play, not an illegal one)")

	# AI: hold it while nothing of ours is damaged, cast it once something is.
	var s4 := _base_state(db, "p1_hero", "p2_hero")
	_add_resources(s4, "p1", 3)
	s4.phase = "action"
