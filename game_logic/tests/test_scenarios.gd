	return db


func _test_life_tap_pays_health_for_cards() -> void:
	_buf.append("
-- Life Tap: 2 damage on your own hero, draw two --")
	var db := _life_tap_db()
	var state := _base_state(db, "p1_hero", "p2_hero")
	_add_resources(state, "p1", 5)
	state.players["p1"].resource_placed_this_turn = true
	_add_card_to_hand(state, "tap", "azeroth_128", "p1")
	_stock_deck(state, "p1", "filler_def", 5)

	# lt-a: nothing is announced — the card names YOUR hero, so there is no pick
	# and the play is legal as it stands.
	var act := PendingAction.make("play_instant", "p1", {"card_id": "tap"})
	ok(StackResolver.can_submit(state, act, db), "lt-a: legal with no pick to announce")
	StackResolver.submit_action(state, act, db)

	# lt-b: the cost is paid on chain entry (412.2) — the damage is already on
	# our hero while the spell still sits on the chain, undrawn.
	ok(state.get_card("p1_hero").damage_taken == 2,
		"lt-b: 2 damage on our hero at announcement")
	ok(state.zones["p1_hand"].card_ids.size() == 0,
		"lt-b2: nothing drawn yet (spell unresolved)")

	# lt-c: health can be healed but a payment can't be un-made.
	ok(not StackResolver.can_retract(state, "p1"),
		"lt-c: announcement is non-retractable")

	StackResolver.pass_priority(state, db)
	StackResolver.pass_priority(state, db)
	ok(state.zones["p1_hand"].card_ids.size() == 2, "lt-d: drew two cards")
	ok("tap" in state.zones["p1_graveyard"].card_ids,
		"lt-d2: the spell resolved to its owner's graveyard")


func _test_life_tap_cost_scope_and_lethality() -> void:
	_buf.append("
-- Life Tap: 405.3 put damage, and it can kill you --")
	var db := _life_tap_db()

	# lt-e: 405.3 — PUT damage is unpreventable, so ready DEF 3 armor neither
	# opens a prevention point nor softens the payment.
	var s1 := _base_state(db, "p1_hero", "p2_hero")
	_add_resources(s1, "p1", 5)
	s1.players["p1"].resource_placed_this_turn = true
	_add_card_to_hand(s1, "tap", "azeroth_128", "p1")
	_stock_deck(s1, "p1", "filler_def", 5)
	var helm := CardInstance.create("helm", "plate_def", "p1", "p1_hero_row")
	s1.cards["helm"] = helm
	s1.zones["p1_hero_row"].card_ids.append("helm")
	StackResolver.submit_action(s1, PendingAction.make("play_instant", "p1",
		{"card_id": "tap"}), db)
	ok(s1.pending_prevention_player == "",
		"lt-e: no armor prevention point opens for put damage")
	ok(s1.get_card("p1_hero").damage_taken == 2,
		"lt-e2: armor did not reduce the cost")
	ok(not helm.is_exhausted, "lt-e3: the armor is untouched (nothing to spend it on)")

	# lt-f: put damage is watcher-silent — it records no `damage_dealt` turn-log
	# entry, so Thysta's "if no damage was dealt this turn" still reads as none.
	ok(not s1.has_turn_event("damage_dealt"),
		"lt-f: the payment is not damage DEALT (405.3)")

	# lt-g: the cost may be exactly fatal — tapping at 2 health loses the game.
	var s2 := _base_state(db, "p1_hero", "p2_hero")
	_add_resources(s2, "p1", 5)
	s2.players["p1"].resource_placed_this_turn = true
	_add_card_to_hand(s2, "tap2", "azeroth_128", "p1")
	_stock_deck(s2, "p1", "filler_def", 5)
	s2.get_card("p1_hero").damage_taken = 28   # 30 max -> 2 left
	var ev := StackResolver.submit_action(s2, PendingAction.make("play_instant", "p1",
		{"card_id": "tap2"}), db)
	var over := false
	for e in ev:
		if e.event_type == "game_over" and e.payload.get("loser", "") == "p1":
			over = true
	ok(over, "lt-g: an exactly-fatal payment ends the game (118.4/704)")


func _test_ai_life_tap() -> void:
	_buf.append("
-- Life Tap: the AI won't tap itself to death --")
	var db := _life_tap_db()
	var ai := BaseAI.new()

	var state := _base_state(db, "p1_hero", "p2_hero")
	_add_resources(state, "p1", 5)
	state.players["p1"].resource_placed_this_turn = true
	_add_card_to_hand(state, "tap", "azeroth_128", "p1")
	_stock_deck(state, "p1", "filler_def", 5)

	# lta-a: healthy hero, room in hand -> the AI buys the cards.
	var found := false
	for a in ai.get_reasonable_actions(state, db, "p1"):
		if a.params.get("card_id", "") == "tap":
			found = true
	ok(found, "lta-a: played with a healthy hero")

	# lta-b: the health gate is the important half — a hero near the floor holds
	# the card rather than paying for cards it may not live to play.
	state.get_card("p1_hero").damage_taken = 22   # 8 left, under the floor
	found = false
	for a in ai.get_reasonable_actions(state, db, "p1"):
		if a.params.get("card_id", "") == "tap":
			found = true
	ok(not found, "lta-b: held while the hero is low")

	# lta-c: and it won't draw past max hand size (503.2a).
	state.get_card("p1_hero").damage_taken = 0
	for i in range(state.get_max_hand_size("p1", db)):
		_add_card_to_hand(state, "junk_%d" % i, "filler_def", "p1")
	found = false
	for a in ai.get_reasonable_actions(state, db, "p1"):
		if a.params.get("card_id", "") == "tap":
			found = true
	ok(not found, "lta-c: held on a full hand")


# ══════════════════════════════════════════════════════════════════════════════
# Shadowmeld (dark_portal_131, 3, Ability, Alliance, Night Elf Hero Required):
#   "Ongoing: Your hero is elusive and untargetable. At the start of your turn,
#    destroy Shadowmeld."
#   requires_hero_race:Night Elf|ongoing|hero_keyword:elusive
#     |hero_keyword:untargetable|turn_start_destroy_self
#
# The first card to carry TWO hero_keyword segments, and the first ever grant of
# untargetable to a hero — both halves are pure CSV, since _hero_keyword_aura
# scans every segment and both gate sites already ask _has_keyword(.., db, state).
# The one new key is turn_start_destroy_self: Fire Nova Totem's self-destroy with
# the burn rider removed, so the card pays for its own grant by leaving play.
#
# Being sorcery speed, it is played on YOUR turn and dies at your NEXT ready step
# — so what it actually covers is the opponent's whole turn in between.
# ══════════════════════════════════════════════════════════════════════════════
const SHADOWMELD_FX := "requires_hero_race:Night Elf|ongoing|hero_keyword:elusive|hero_keyword:untargetable|turn_start_destroy_self"

func _shadowmeld_db() -> MockDB:
	var db := MockDB.new()
	db.hero("p1_hero", 30)
	db.hero("p2_hero", 30)
	db.ability("meld_def", 3, SHADOWMELD_FX)
	db.ability("bolt_def", 2, "deal_damage_to_target:3:fire")
	db.ally("grunt_def", 3, 3, [], 2)
	return db


func _test_shadowmeld_hero_elusive_and_untargetable() -> void:
	_buf.append("\n-- Shadowmeld: hero is elusive AND untargetable, then it expires --")
	var db := _shadowmeld_db()
	var state := _base_state(db, "p1_hero", "p2_hero")
	var mine := _add_ally(state, "mine", "grunt_def", "p1")
	mine.just_summoned = false
	var atk := _add_ally(state, "atk", "grunt_def", "p2")
	atk.just_summoned = false
	_add_card_to_hand(state, "meld", "meld_def", "p1")
	_add_card_to_hand(state, "bolt", "bolt_def", "p2")
	_add_resources(state, "p1", 5)
	_add_resources(state, "p2", 5)
	state.players["p1"].resource_placed_this_turn = true
	state.players["p2"].resource_placed_this_turn = true

	ok("p1_hero" in StackResolver.get_legal_defenders(state, "atk", db),
		"smeld-a: our hero is attackable before Shadowmeld lands")

	# An ongoing Ability routes to play_ability and settles in the hero row.
	var play := PendingAction.make("play_ability", "p1", {"card_id": "meld"})
	ok(StackResolver.can_submit(state, play, db), "smeld-b: Shadowmeld is playable")
	StackResolver.submit_action(state, play, db)
	StackResolver.pass_priority(state, db)
	StackResolver.pass_priority(state, db)
	eq(state.get_card("meld").zone_id, "p1_hero_row",
		"smeld-c: it stays in play in the hero row")

	# BOTH keyword segments on the one card are read — this is the first card to
	# carry two, and the first to grant a hero untargetable at all.
	var hero := state.get_card("p1_hero")
	ok(StackResolver._has_keyword(hero, "elusive", db, state),
		"smeld-d: our hero has elusive")
	ok(StackResolver._has_keyword(hero, "untargetable", db, state),
		"smeld-e: ...and untargetable, from the same card")

	# Elusive (601.2b): can't be proposed as a defender, so attacks are funnelled
	# at our allies.
	ok("p1_hero" not in StackResolver.get_legal_defenders(state, "atk", db),
		"smeld-f: our hero can no longer be proposed as a defender")
	ok("mine" in StackResolver.get_legal_defenders(state, "atk", db),
		"smeld-g: our allies still are")

	# Untargetable (706): no link may choose it as a target.
	state.turn_player     = "p2"
	state.priority_player = "p2"
	var at_hero := PendingAction.make("propose_combat", "p2",
		{"attacker_id": "atk", "defender_id": "p1_hero"})
	ok(not StackResolver.can_submit(state, at_hero, db),
		"smeld-h: an attack on our hero can't be submitted")
	var burn := PendingAction.make("play_ability", "p2",
		{"card_id": "bolt", "target_id": "p1_hero"})
	ok(not StackResolver.can_submit(state, burn, db),
		"smeld-i: a targeted burn can't name our hero either")
	var burn_ally := PendingAction.make("play_ability", "p2",
		{"card_id": "bolt", "target_id": "mine"})
	ok(StackResolver.can_submit(state, burn_ally, db),
		"smeld-j: ...but our allies are still targetable — the grant is hero-only")

	# Scope: our own allies and the OPPONENT's hero get nothing ("your hero").
	ok(not StackResolver._has_keyword(mine, "elusive", db, state),
		"smeld-k: our allies are unaffected")
	ok(not StackResolver._has_keyword(state.get_card("p2_hero"), "untargetable", db, state),
		"smeld-l: the opponent's hero is unaffected")

	# "At the start of YOUR turn" — the opponent's ready step must not fire it.
	_ready_step(state, db)
	eq(state.get_card("meld").zone_id, "p1_hero_row",
		"smeld-m: it survives the opponent's ready step")
	ok(StackResolver._has_keyword(state.get_card("p1_hero"), "elusive", db, state),
		"smeld-n: ...so the grant covers their whole turn")

	# Our own ready step: it destroys itself, and both grants lift with it — every
	# aura read is live off the board, so nothing has to be un-granted.
	state.turn_player = "p1"
	_ready_step(state, db)
	eq(state.get_card("meld").zone_id, "p1_graveyard",
		"smeld-o: it destroys itself at our next ready step")
	ok(not StackResolver._has_keyword(state.get_card("p1_hero"), "elusive", db, state),
		"smeld-p: elusive is gone")
	ok(not StackResolver._has_keyword(state.get_card("p1_hero"), "untargetable", db, state),
		"smeld-q: and so is untargetable")
	ok("p1_hero" in StackResolver.get_legal_defenders(state, "atk", db),
		"smeld-r: our hero is attackable again")


func _test_shadowmeld_expiry_is_respondable() -> void:
	_buf.append("\n-- Shadowmeld: the self-destroy is a chain link, answerable (709.2c) --")
	var db := _shadowmeld_db()
	var state := _base_state(db, "p1_hero", "p2_hero")
	state.phase = "ready"
	var meld := CardInstance.create("meld", "meld_def", "p1", "p1_hero_row")
	state.cards["meld"] = meld
	state.zones["p1_hero_row"].card_ids.append("meld")

	state.pending_turn_start_triggers = [{
		"card_id": "meld", "controller": "p1",
		"key": "turn_start_destroy_self", "args": []}]
	StackResolver.advance_turn_start_triggers(state, db)
	eq(state.pending_actions.size(), 1, "smx-a: the expiry is a chain link")
	eq(state.pending_actions[0].action_type, "resolve_turn_start_trigger",
		"smx-b: ...a resolve_turn_start_trigger")
	eq(state.get_card("meld").zone_id, "p1_hero_row",
		"smx-c: still in play — the destroy belongs to RESOLUTION")
	ok(StackResolver._has_keyword(state.get_card("p1_hero"), "untargetable", db, state),
		"smx-d: ...so the grant is still up while the link waits")

	StackResolver.pass_priority(state, db)
	StackResolver.pass_priority(state, db)
	eq(state.pending_actions.size(), 0, "smx-e: the link resolved")
	eq(state.get_card("meld").zone_id, "p1_graveyard", "smx-f: and it is destroyed")

	# 709.2c: a source already gone when the link resolves has nothing to destroy,
	# so the link resolves into nothing — and the grant is gone regardless.
	var gone := _base_state(db, "p1_hero", "p2_hero")
	gone.phase = "ready"
	var m2 := CardInstance.create("meld", "meld_def", "p1", "p1_hero_row")
	gone.cards["meld"] = m2
	gone.zones["p1_hero_row"].card_ids.append("meld")
	gone.pending_turn_start_triggers = [{
		"card_id": "meld", "controller": "p1",
		"key": "turn_start_destroy_self", "args": []}]
	StackResolver.advance_turn_start_triggers(gone, db)
	GameLogic.move_card(gone, "meld", "p1_rfg")
	StackResolver.pass_priority(gone, db)
	StackResolver.pass_priority(gone, db)
	eq(gone.get_card("meld").zone_id, "p1_rfg",
		"smx-g: exiled in the window, it is not dragged to a graveyard")
	ok(not StackResolver._has_keyword(gone.get_card("p1_hero"), "elusive", db, gone),
		"smx-h: and the grant lifted anyway — every aura read is live")


# ── Avanthera (dark_portal_154) ───────────────────────────────────────────────
# "(1) -> If Avanthera is in combat, remove her from combat."
func _avanthera_db():
	var db := MockDB.new()
	db.hero("p1_hero", 30)
	db.hero("p2_hero", 30)
	db.ally("avanthera_def", 3, 2, [], 2,
		"activated_power:1:remove_self_from_combat:0:::no_activate")
	db.ally("brute_def", 4, 4, [], 3)
	return db


func _test_avanthera_removes_herself_from_combat() -> void:
	_buf.append("\n-- Avanthera: escapes a combat, cancelling it in BOTH directions --")
	var db = _avanthera_db()

	# av-a: she DEFENDS against a 4/4 that would kill her, and walks away.
	var st := _base_state(db, "p1_hero", "p2_hero")
	st.turn_player     = "p2"
	st.priority_player = "p2"
	_add_resources(st, "p1", 1)
	var av := _add_ally(st, "av", "avanthera_def", "p1")
	av.just_summoned = false
	var brute := _add_ally(st, "brute", "brute_def", "p2")
	brute.just_summoned = false
	st.players["p1"].resource_placed_this_turn = true
	st.players["p2"].resource_placed_this_turn = true

	StackResolver.submit_action(st, PendingAction.make("propose_combat", "p2",
		{"attacker_id": "brute", "defender_id": "av"}), db)
	StackResolver.pass_priority(st, db)
	StackResolver.pass_priority(st, db)   # combat starts -> attack window

	# 602.1/602.3b: she is an attacker/defender-to-be but NOT YET in combat, so
	# the power is illegal here — the whole point of the defend-window gate.
	ok(st.combat_attack_window, "av-a0: attack window open")
	ok(not StackResolver.is_in_combat(st, "av"),
		"av-a1: not in combat during the attack window (602.1)")
	ok(not StackResolver.can_submit(st, PendingAction.make("use_ally_power", "p1",
		{"card_id": "av"}), db), "av-a2: power illegal in the attack window")

	StackResolver.pass_priority(st, db)
	StackResolver.pass_priority(st, db)   # no protectors -> defend window
	ok(st.combat_defend_window, "av-a3: defend window open")
	ok(StackResolver.is_in_combat(st, "av"), "av-a4: in combat now (602.3)")

	StackResolver.pass_priority(st, db)   # turn player (p2) passes -> p1
	var ev := StackResolver.submit_action(st, PendingAction.make("use_ally_power", "p1",
		{"card_id": "av"}), db)
	ok(not av.is_exhausted, "av-a5: no [Activate] tap symbol — she doesn't exhaust")
	eq(st.get_available_resources("p1"), 0, "av-a6: paid 1")
	StackResolver.pass_priority(st, db)
	var res := StackResolver.pass_priority(st, db)   # the power resolves
	eq(st.combat_defender, "", "av-b: removed from combat")
	var saw := false
	for e in res:
		if e.event_type == "card_removed_from_combat" \
				and e.payload.get("card_id", "") == "av" \
				and e.payload.get("role", "") == "defender":
			saw = true
	ok(saw, "av-b2: card_removed_from_combat emitted with the role")
	ok(st.combat_defend_window,
		"av-b3: 602.4 — the combat step does NOT end immediately")

	StackResolver.pass_priority(st, db)
	StackResolver.pass_priority(st, db)   # window closes -> conclusion (603.1b)
	ok(not st.combat_defend_window, "av-c: combat concluded")
	eq(st.get_card("av").damage_taken, 0, "av-c2: she took no damage")
	eq(st.get_card("brute").damage_taken, 0,
		"av-c3: and dealt none either — 603.1b cancels BOTH packets")
	ok(st.get_card("brute").is_exhausted,
		"av-c4: the attacker stays exhausted and doesn't ready (602.1/603.1b)")


func _test_avanthera_attacking_and_repeatable() -> void:
	_buf.append("\n-- Avanthera: works from the ATTACKING role, and is repeatable --")
	var db = _avanthera_db()

	var st := _base_state(db, "p1_hero", "p2_hero")
	st.turn_player     = "p1"
	st.priority_player = "p1"
	_add_resources(st, "p1", 2)
	var av := _add_ally(st, "av", "avanthera_def", "p1")
	av.just_summoned = false
	var brute := _add_ally(st, "brute", "brute_def", "p2")
	brute.just_summoned = false
	st.players["p1"].resource_placed_this_turn = true
	st.players["p2"].resource_placed_this_turn = true

	StackResolver.submit_action(st, PendingAction.make("propose_combat", "p1",
		{"attacker_id": "av", "defender_id": "brute"}), db)
	StackResolver.pass_priority(st, db)
	StackResolver.pass_priority(st, db)   # attack window
	StackResolver.pass_priority(st, db)
	StackResolver.pass_priority(st, db)   # defend window
	ok(st.combat_defend_window, "av-d0: defend window open")
	ok(av.is_exhausted, "av-d1: she exhausted to attack (602.1)")

	StackResolver.submit_action(st, PendingAction.make("use_ally_power", "p1",
		{"card_id": "av"}), db)
	StackResolver.pass_priority(st, db)
	StackResolver.pass_priority(st, db)
	eq(st.combat_attacker, "", "av-d: the ATTACKER can leave too")
	ok(av.is_exhausted,
		"av-d2: still exhausted — leaving combat is not a ready effect")

	StackResolver.pass_priority(st, db)
	StackResolver.pass_priority(st, db)   # conclusion
	eq(st.get_card("brute").damage_taken, 0, "av-e: no damage dealt")
	eq(st.get_card("av").damage_taken, 0, "av-e2: and none taken")

	# av-f: out of combat, the power is illegal — the "if" clause is a use gate.
	ok(not StackResolver.can_submit(st, PendingAction.make("use_ally_power", "p1",
		{"card_id": "av"}), db), "av-f: illegal outside combat")
	# ...and no_activate means being exhausted never blocked it (av-d proved the
	# use; this pins that the refusal above is the combat gate, not the exhaust).
	ok(av.is_exhausted, "av-f2: still exhausted, so the gate above was 'in combat'")


func _test_ai_avanthera() -> void:
	_buf.append("\n-- Avanthera AI: escapes only a combat she would not survive --")
	var db = _avanthera_db()
	var ai := BaseAI.new()

	# av-g: 4/4 attacker vs her 3/2 — she dies, so pull out.
	var st := _base_state(db, "p1_hero", "p2_hero")
	st.turn_player = "p2"
	_add_resources(st, "p1", 1)
	var av := _add_ally(st, "av", "avanthera_def", "p1")
	av.just_summoned = false
	var brute := _add_ally(st, "brute", "brute_def", "p2")
	brute.just_summoned = false
	st.combat_attacker = "brute"
	st.combat_defender = "av"
	st.combat_defend_window = true
	st.priority_player = "p1"
	var act = ai.avanthera_escape_action(st, db, "p1")
	ok(act != null and act.params.get("card_id", "") == "av",
		"av-g: escapes a lethal combat")

	# av-h: a 1/1 attacker — she wins the fight, so leaving throws the kill away.
	var st2 := _base_state(db, "p1_hero", "p2_hero")
	st2.turn_player = "p2"
	_add_resources(st2, "p1", 1)
	db.ally("chump_def", 1, 1, [], 1)
	var av2 := _add_ally(st2, "av", "avanthera_def", "p1")
	av2.just_summoned = false
	var chump := _add_ally(st2, "chump", "chump_def", "p2")
	chump.just_summoned = false
	st2.combat_attacker = "chump"
	st2.combat_defender = "av"
	st2.combat_defend_window = true
	st2.priority_player = "p1"
	ok(ai.avanthera_escape_action(st2, db, "p1") == null,
		"av-h: holds when she survives the combat")

	# av-i: not in combat at all — nothing to do.
	var st3 := _base_state(db, "p1_hero", "p2_hero")
	_add_resources(st3, "p1", 1)
	var av3 := _add_ally(st3, "av", "avanthera_def", "p1")
	av3.just_summoned = false
	st3.priority_player = "p1"
	ok(ai.avanthera_escape_action(st3, db, "p1") == null,
		"av-i: no action outside combat")

const GHOST_WOLF_FX := "ongoing|activated_power:0:remove_attacking_allies:0:::exhaust_hero+no_activate"


func _ghost_wolf_db() -> MockDB:
	var db := MockDB.new()
	db.hero("p1_hero", 30)
	db.hero("p2_hero", 30)
	db.ally("brute_def", 4, 4, [], 3)
	db.ability("azeroth_110", 2, GHOST_WOLF_FX)
	return db


# Puts Ghost Wolf into p1's hero row by PLAYING it, so the ongoing routing is
# exercised rather than assumed.
func _play_ghost_wolf(state: GameState, db) -> void:
	_add_card_to_hand(state, "gw", "azeroth_110", "p1")
	StackResolver.submit_action(state, PendingAction.make("play_ability", "p1",
		{"card_id": "gw"}), db)
	StackResolver.pass_priority(state, db)
	StackResolver.pass_priority(state, db)


func _test_ghost_wolf_removes_attacking_ally() -> void:
	_buf.append("\n-- Ghost Wolf: cancels an ally attack on the defending hero --")
	var db = _ghost_wolf_db()

	var st := _base_state(db, "p1_hero", "p2_hero")
	st.turn_player     = "p1"
	st.priority_player = "p1"
	_add_resources(st, "p1", 2)
	_play_ghost_wolf(st, db)
	eq(st.get_card("gw").zone_id, "p1_hero_row", "gw-a: ongoing, in the hero row")

	# p2 attacks our hero with an ally.
	st.turn_player     = "p2"
	st.priority_player = "p2"
	st.players["p1"].resource_placed_this_turn = true
	st.players["p2"].resource_placed_this_turn = true
	var brute := _add_ally(st, "brute", "brute_def", "p2")
	brute.just_summoned = false

	StackResolver.submit_action(st, PendingAction.make("propose_combat", "p2",
		{"attacker_id": "brute", "defender_id": "p1_hero"}), db)
	StackResolver.pass_priority(st, db)
	StackResolver.pass_priority(st, db)   # attack window opens
	StackResolver.pass_priority(st, db)   # p2 passes -> we hold priority

	# gw-b: the attack window is NOT a defend window (602.3) — the power is still
	# perfectly legal there, it just resolves into nothing.
	var early := PendingAction.make("use_ally_power", "p1", {"card_id": "gw"})
	ok(StackResolver.can_submit(st, early, db),
		"gw-b: legal in the attack window (effect condition, not a use gate)")

	StackResolver.pass_priority(st, db)   # defend window opens
	ok(st.combat_defend_window, "gw-c: defend window open")
	eq(st.combat_defender, "p1_hero", "gw-c2: our hero is the defender")
	StackResolver.pass_priority(st, db)   # p2 passes -> we hold priority

	var hero := st.get_card("p1_hero")
	ok(not hero.is_exhausted, "gw-d: hero ready before the power")
	StackResolver.submit_action(st, PendingAction.make("use_ally_power", "p1",
		{"card_id": "gw"}), db)
	ok(hero.is_exhausted, "gw-e: hero exhausted at ANNOUNCEMENT (412.2)")
	eq(st.get_card("gw").zone_id, "p1_hero_row",
		"gw-e2: no [Activate] symbol — the source itself never exhausts or leaves")
	StackResolver.pass_priority(st, db)
	StackResolver.pass_priority(st, db)   # the power resolves

	eq(st.combat_attacker, "", "gw-f: the attacking ally left combat")
	ok(st.get_card("brute").is_exhausted,
		"gw-f2: it stays exhausted — leaving combat is not a ready effect (602.1)")

	# 602.4: the step does NOT end here; the conclusion's 603.1b check then deals
	# no damage in EITHER direction.
	StackResolver.pass_priority(st, db)
	StackResolver.pass_priority(st, db)   # conclusion
	eq(hero.damage_taken, 0, "gw-g: hero took no combat damage")
	eq(st.get_card("brute").damage_taken, 0, "gw-g2: and dealt none, took none")


func _test_ghost_wolf_scope_and_fizzle() -> void:
	_buf.append("\n-- Ghost Wolf: allies only, defending only, hero-exhaust cost --")
	var db = _ghost_wolf_db()

	# gw-h: an attacking HERO is not an "attacking ally" — the power resolves
	# into nothing and the combat proceeds, with the hero-exhaust still spent.
	var st := _base_state(db, "p1_hero", "p2_hero")
	st.turn_player     = "p1"
	st.priority_player = "p1"
	_add_resources(st, "p1", 2)
	_play_ghost_wolf(st, db)
	st.turn_player     = "p2"
	st.players["p1"].resource_placed_this_turn = true
	st.players["p2"].resource_placed_this_turn = true
	st.combat_attacker      = "p2_hero"
	st.combat_defender      = "p1_hero"
	st.combat_defend_window = true
	st.priority_player      = "p1"
	StackResolver.submit_action(st, PendingAction.make("use_ally_power", "p1",
		{"card_id": "gw"}), db)
	StackResolver.pass_priority(st, db)
	StackResolver.pass_priority(st, db)
	eq(st.combat_attacker, "p2_hero", "gw-h: an attacking HERO is not removed")
	ok(st.get_card("p1_hero").is_exhausted,
		"gw-h2: the cost was still paid — 709.2c, only as much as possible happens")

	# gw-i: an EXHAUSTED hero can't pay the cost, so the power is unusable.
	ok(not StackResolver.can_submit(st, PendingAction.make("use_ally_power", "p1",
		{"card_id": "gw"}), db), "gw-i: exhaust_hero needs a READY hero")

	# gw-j: our hero is not the defender — someone else's combat is not our
	# business, and the power does nothing.
	var st2 := _base_state(db, "p1_hero", "p2_hero")
	st2.turn_player     = "p1"
	st2.priority_player = "p1"
	_add_resources(st2, "p1", 2)
	_play_ghost_wolf(st2, db)
	var mine := _add_ally(st2, "mine", "brute_def", "p1")
	mine.just_summoned = false
	var theirs := _add_ally(st2, "theirs", "brute_def", "p2")
	theirs.just_summoned = false
	st2.combat_attacker      = "theirs"
	st2.combat_defender      = "mine"
	st2.combat_defend_window = true
	st2.priority_player      = "p1"
	StackResolver.submit_action(st2, PendingAction.make("use_ally_power", "p1",
		{"card_id": "gw"}), db)
	StackResolver.pass_priority(st2, db)
	StackResolver.pass_priority(st2, db)
	eq(st2.combat_attacker, "theirs",
		"gw-j: nothing happens when an ALLY of ours is the defender")


func _test_ai_ghost_wolf() -> void:
	_buf.append("\n-- Ghost Wolf AI: only an ally attack our hero is defending --")
	var db = _ghost_wolf_db()
	var ai := BaseAI.new()

	# gw-k: ally attacking our defending hero — fire it.
	var st := _base_state(db, "p1_hero", "p2_hero")
	st.turn_player     = "p1"
	st.priority_player = "p1"
	_add_resources(st, "p1", 2)
	_play_ghost_wolf(st, db)
	st.turn_player = "p2"
	var brute := _add_ally(st, "brute", "brute_def", "p2")
	brute.just_summoned = false
	st.combat_attacker      = "brute"
	st.combat_defender      = "p1_hero"
	st.combat_defend_window = true
	st.priority_player      = "p1"
	var act = ai.ghost_wolf_action(st, db, "p1")
	ok(act != null and act.params.get("card_id", "") == "gw",
		"gw-k: fires on an ally attack our hero is defending")

	# gw-l: attacking HERO — the power removes allies only, so hold.
	st.combat_attacker = "p2_hero"
	ok(ai.ghost_wolf_action(st, db, "p1") == null,
		"gw-l: holds against an attacking hero")

	# gw-m: attack window, not defend — our hero is only a PROPOSED defender.
	st.combat_attacker      = "brute"
	st.combat_defend_window = false
	st.combat_attack_window = true
	ok(ai.ghost_wolf_action(st, db, "p1") == null,
		"gw-m: holds in the attack window (602.3)")

	# gw-n: and it is never fired blind on our own turn by the generic branch.
	var st2 := _base_state(db, "p1_hero", "p2_hero")
	st2.turn_player     = "p1"
	st2.priority_player = "p1"
	_add_resources(st2, "p1", 4)
	_play_ghost_wolf(st2, db)
	var found := false
	for a in ai.get_reasonable_actions(st2, db, "p1"):
		if a.action_type == "use_ally_power" and a.params.get("card_id", "") == "gw":
			found = true
	ok(not found, "gw-n: never blind-played outside a defend window")


const TOTEMIC_CALL_FX := "mode_if_totem:air:ready_hero_and_melee_weapon|mode_if_totem:earth:party_allies_atk_this_turn:1|mode_if_totem:fire:deal_damage_to_target:2:fire|mode_if_totem:water:draw:2"


func _totemic_db() -> MockDB:
	var db := MockDB.new()
	db.hero("p1_hero", 30)
	db.hero("p2_hero", 30)
	db.ally("brute_def", 2, 2, [], 2)
	db.weapon("krol_def", 3, 3, 1)                      # Melee, 3 ATK, strike 1
	db.weapon("bow_def", 2, 2, 1, "Ranged", "ranged_weapon")             # Ranged
	db.instant("air_totem",   1, "ongoing|totem:air")
	db.instant("earth_totem", 1, "ongoing|totem:earth")
	db.instant("fire_totem",  1, "ongoing|totem:fire")
	db.instant("water_totem", 1, "ongoing|totem:water")
	db.instant("azeroth_117", 4, TOTEMIC_CALL_FX)
	return db


func _add_totem(state: GameState, inst_id: String, def_id: String, ctrl: String) -> CardInstance:
	var card := CardInstance.create(inst_id, def_id, ctrl, ctrl + "_ally_row")
	state.cards[inst_id] = card
	state.zones[ctrl + "_ally_row"].card_ids.append(inst_id)
	return card


func _test_totemic_call_modes_and_availability() -> void:
	_buf.append("\n-- Totemic Call: choose one or more, each gated on a totem --")
	var db = _totemic_db()

	# tc-a: with NO totem out, no mode is available, so the card can't be
	# announced at all — "one or more" cannot be satisfied by zero (707.1c).
	var st := _base_state(db, "p1_hero", "p2_hero")
	_add_resources(st, "p1", 6)
	_add_card_to_hand(st, "tc", "azeroth_117", "p1")
	var probe := PendingAction.make("play_instant", "p1",
		{"card_id": "tc", "_skip_target_check": true})
	ok(not StackResolver.can_submit(st, probe, db),
		"tc-a: unplayable with no totem in play (the highlight probe darks it)")

	_add_totem(st, "wt", "water_totem", "p1")
	ok(StackResolver.can_submit(st, probe, db),
		"tc-a2: one totem is enough to make it playable")

	# tc-b: you may only choose modes whose totem you control. Index 3 is water.
	ok(not StackResolver.can_submit(st, PendingAction.make("play_instant", "p1",
		{"card_id": "tc", "modes": [1]}), db),
		"tc-b: can't choose the Earth mode with no Earth Totem")
	ok(not StackResolver.can_submit(st, PendingAction.make("play_instant", "p1",
		{"card_id": "tc", "modes": []}), db),
		"tc-b2: and choosing NOTHING is not a legal announcement")
	ok(StackResolver.can_submit(st, PendingAction.make("play_instant", "p1",
		{"card_id": "tc", "modes": [3]}), db),
		"tc-b3: the Water mode is legal")

	# tc-c: only the FIRE mode announces a target (errata).
	_add_totem(st, "ft", "fire_totem", "p1")
	ok(not StackResolver.can_submit(st, PendingAction.make("play_instant", "p1",
		{"card_id": "tc", "modes": [2]}), db),
		"tc-c: the Fire mode needs a target")
	ok(StackResolver.can_submit(st, PendingAction.make("play_instant", "p1",
		{"card_id": "tc", "modes": [2], "target_id": "p2_hero"}), db),
		"tc-c2: …and takes an ordinary hero-or-ally one")
	ok(StackResolver.can_submit(st, PendingAction.make("play_instant", "p1",
		{"card_id": "tc", "modes": [3]}), db),
		"tc-c3: while the Water mode announces none")


func _test_totemic_call_all_four_modes() -> void:
	_buf.append("\n-- Totemic Call: all four modes resolving together --")
	var db = _totemic_db()
	var st := _base_state(db, "p1_hero", "p2_hero")
	_add_resources(st, "p1", 6)
	_stock_deck(st, "p1", "brute_def", 4)
	_add_card_to_hand(st, "tc", "azeroth_117", "p1")
	_add_totem(st, "at", "air_totem",   "p1")
	_add_totem(st, "et", "earth_totem", "p1")
	_add_totem(st, "ft", "fire_totem",  "p1")
	_add_totem(st, "wt", "water_totem", "p1")

	# An exhausted hero and an exhausted Melee weapon for the Air mode, plus an
	# exhausted RANGED weapon that must NOT be readied ("Melee weapons").
	var hero := st.get_card("p1_hero")
	hero.is_exhausted = true
	var krol := CardInstance.create("krol", "krol_def", "p1", "p1_hero_row")
	krol.is_exhausted = true
	st.cards["krol"] = krol
	st.zones["p1_hero_row"].card_ids.append("krol")
	var bow := CardInstance.create("bow", "bow_def", "p1", "p1_hero_row")
	bow.is_exhausted = true
	st.cards["bow"] = bow
	st.zones["p1_hero_row"].card_ids.append("bow")

	var mine := _add_ally(st, "mine", "brute_def", "p1")
	var victim := _add_ally(st, "victim", "brute_def", "p2")
	var hand_before := st.cards_in_zone("p1_hand").size()

	StackResolver.submit_action(st, PendingAction.make("play_instant", "p1",
		{"card_id": "tc", "modes": [0, 1, 2, 3], "target_id": "victim"}), db)
	StackResolver.pass_priority(st, db)
	StackResolver.pass_priority(st, db)   # resolves

	# Air — exactly ONE Melee weapon is exhausted, so it readies with no prompt.
	ok(not hero.is_exhausted, "tc-d: Air readied our hero")
	ok(not krol.is_exhausted, "tc-d2: …and the Melee weapon, with no choice point")
	eq(st.pending_weapon_ready_player, "", "tc-d3: one candidate opens no prompt")
	ok(bow.is_exhausted, "tc-d4: the RANGED weapon is untouched (Melee only)")

	# Earth — an unconditional +1 ATK this turn, so it counts while NOT attacking
	# (that is the whole difference from Rayder's while-attacking grant).
	eq(st.get_atk("mine", db), 3, "tc-e: Earth gave our ally +1 ATK, defending too")
	eq(st.get_atk("p1_hero", db), 0, "tc-e2: …and not our hero (\"allies\")")

	# Fire — 2 fire damage on the announced target. The victim is a 2/2, so the
	# burn kills it outright.
	ok(not st.is_in_play("victim"), "tc-f: Fire killed the 2-health target")

	# Water — two cards, minus the spell that left the hand.
	eq(st.cards_in_zone("p1_hand").size(), hand_before - 1 + 2,
		"tc-g: Water drew two cards")


func _test_totemic_call_resolution_rechecks() -> void:
	_buf.append("\n-- Totemic Call: the errata's interrupt, and per-mode fizzles --")
	var db = _totemic_db()

	# tc-h: THE ERRATA. An illegal fire target at resolution interrupts the
	# ENTIRE card — the water draw goes with it, unlike an ordinary per-half
	# fizzle (Ravenous Bite).
	var st := _base_state(db, "p1_hero", "p2_hero")
	_add_resources(st, "p1", 6)
	_stock_deck(st, "p1", "brute_def", 4)
	_add_card_to_hand(st, "tc", "azeroth_117", "p1")
	_add_totem(st, "ft", "fire_totem",  "p1")
	_add_totem(st, "wt", "water_totem", "p1")
	var victim := _add_ally(st, "victim", "brute_def", "p2")
	var hand_before := st.cards_in_zone("p1_hand").size()
	StackResolver.submit_action(st, PendingAction.make("play_instant", "p1",
		{"card_id": "tc", "modes": [2, 3], "target_id": "victim"}), db)
	# The target leaves play in the response window.
	GameLogic.destroy_card(st, "victim", "victim")
	StackResolver.pass_priority(st, db)
	StackResolver.pass_priority(st, db)   # resolves
	eq(st.cards_in_zone("p1_hand").size(), hand_before - 1,
		"tc-h: an illegal fire target interrupts the WHOLE card — no draw either")

	# tc-i: losing a totem in the response window silences THAT mode only
	# (709.2c), which is the ordinary behaviour the errata's clause is an
	# exception to.
	var st2 := _base_state(db, "p1_hero", "p2_hero")
	_add_resources(st2, "p1", 6)
	_stock_deck(st2, "p1", "brute_def", 4)
	_add_card_to_hand(st2, "tc", "azeroth_117", "p1")
	_add_totem(st2, "et", "earth_totem", "p1")
	_add_totem(st2, "wt", "water_totem", "p1")
	var mine2 := _add_ally(st2, "mine", "brute_def", "p1")
	var hand_before2 := st2.cards_in_zone("p1_hand").size()
	StackResolver.submit_action(st2, PendingAction.make("play_instant", "p1",
		{"card_id": "tc", "modes": [1, 3]}), db)
	GameLogic.destroy_card(st2, "et", "et")   # the Earth Totem dies in response
	StackResolver.pass_priority(st2, db)
	StackResolver.pass_priority(st2, db)
	eq(st2.get_atk("mine", db), 2, "tc-i: the Earth mode did nothing — its totem is gone")
	eq(st2.cards_in_zone("p1_hand").size(), hand_before2 - 1 + 2,
		"tc-i2: …but the Water mode still drew, the card was NOT interrupted")


